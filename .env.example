# Copy to .env and fill in values (never commit .env).
PII_SYNTH_LLM_API_KEY=
PII_SYNTH_LLM_BASE_URL=

# Optional overrides (defaults shown in code if unset):
# PII_SYNTH_LLM_MODEL=glm-5.3-flash
# PII_SYNTH_LLM_USER_AGENT=pii-synthea/1.0
# PII_SYNTH_LLM_OPENCODE_SESSION=stable-uuid-for-batch-run
# PII_SYNTH_ENV_FILE=/absolute/path/to/.env
#
# OpenCode Go (external scripts): base URL must be https://opencode.ai/zen/go/v1
# and model id is bare name (e.g. mimo-v2.5), not opencode-go/mimo-v2.5.
